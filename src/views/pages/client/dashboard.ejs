<%- include('../../partials/head', { bodyClass: 'appwrap', title: 'Client Area' }) %>
<%- include('../../partials/sidebar') %>

<main class="main">
  <div class="pagehead">
    <div>
      <h1>Selamat datang, <%= user.fullName.split(' ')[0] %></h1>
      <p>Semua VPS milik Anda dalam satu tempat.</p>
    </div>
    <a class="btn" href="/#paket">+ VPS Baru</a>
  </div>

  <div class="banner-warning" style="margin-bottom:1.25rem">
    <span class="big">⚠</span><span><%= warningText %></span>
  </div>

  <% if (orders.length === 0) { %>
    <div class="card" style="text-align:center;padding:3rem">
      <div style="font-size:2.4rem;">🖥️</div>
      <h3 style="margin-top:.5rem">Belum ada VPS</h3>
      <p style="color:var(--muted-foreground)">Pilih paket untuk membuat VPS pertama Anda — prosesnya instan.</p>
      <a class="btn" href="/#paket">Lihat Paket</a>
    </div>
  <% } else { %>
    <div class="tablewrap">
      <table>
        <thead><tr>
          <th>ID</th><th>Paket</th><th>Status</th><th>SSH (publik)</th><th>Tanggal</th><th></th>
        </tr></thead>
        <tbody>
        <% orders.forEach(function (o) { %>
          <tr>
            <td><code><%= o.id.slice(0,8).toUpperCase() %></code></td>
            <td><b><%= o.package.name %></b><br><small style="color:var(--muted-foreground)"><%= o.package.vcpu %> vCPU / <%= o.package.ramMb %>MB / <%= o.package.diskGb %>GB</small></td>
            <td>
              <% if (o.status === 'ACTIVE') { %><span class="badge green">Active</span>
              <% } else if (o.status === 'PENDING_PAYMENT') { %><span class="badge amber">Menunggu Verifikasi</span>
              <% } else if (o.status === 'EXPIRED') { %><span class="badge red">Expired</span>
              <% } else { %><span class="badge red">Rejected</span><% } %>
            </td>
            <td><%= o.vps ? `<code>${o.id}.mystorage.biz.id:${o.vps.portCustom}</code>` : '—' %></td>
            <td><%= new Date(o.createdAt).toLocaleDateString('id-ID') %></td>
            <td style="text-align:right"><a class="btn ghost sm" href="/client/order/<%= o.id %>">Detail →</a></td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</main>

<%- include('../../partials/foot') %>
