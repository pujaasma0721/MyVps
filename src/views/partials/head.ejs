<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title ? title + " · MYVPS" : "MYVPS — VPS Rumah" %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/css/theme.css?v=2">
  <% if ((bodyClass || '').indexOf('appwrap') !== -1) { %>
  <link rel="stylesheet" href="/static/css/client-area.css?v=1">
  <% } %>
  <script>
    // apply saved theme before paint to avoid flash
    try { if (localStorage.getItem("myvps-theme") === "dark") document.documentElement.classList.add("dark"); } catch (e) {}
  </script>
</head>
<body class="<%= bodyClass || 'pubwrap' %>">
