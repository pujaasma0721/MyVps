# =====================================================================
# MYVPS BILLING & MONITORING — ENVIRONMENT TEMPLATE
# Copy to .env and fill real values. NEVER commit the real .env.
# =====================================================================

# ---- Server HTTP -----------------------------------------------------
PORT=3500
NODE_ENV=production
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
APP_BASE_URL=http://localhost:3500

# ---- Database (PostgreSQL) -------------------------------------------
DATABASE_URL="postgresql://vpsbilling:vpsbilling@localhost:5432/vpsbilling?schema=public"

# ---- Identity of this business --------------------------------------
# Static public IP of the home network / Proxmox host
PUBLIC_IP=203.0.113.10
# Main business domain (wildcard cert *.MAIN_DOMAIN already on Nginx host)
MAIN_DOMAIN=vpsrumah.com
# Host OS Proxmox node name
PROXMOX_NODE=pve
# Master cloud-init template VM id
PROXMOX_TEMPLATE_ID=100

# ---- LXC tier (optional second product line) -------------------------
# Node-local tarball + storage for container rootfs (PVE create-lxc API)
PROXMOX_LXC_OSTEMPLATE="local:vztmpl/ubuntu-22.04-standard_22.04-1_amd64.tar.zst"
PROXMOX_LXC_STORAGE=local-lvm

# ---- Proxmox VE API --------------------------------------------------
# Internal URL of the PVE host API (runs on the host itself)
PROXMOX_API_URL=https://127.0.0.1:8006
# API-token credentials (recommended): root@pam!myvps with privilege separation off
PROXMOX_TOKEN_USER=root@pam
PROXMOX_TOKEN_ID=myvps
PROXMOX_API_KEY=xxxx-xxxx-xxxx-xxxx-xxxx
# Skip self-signed cert validation (PVE uses self-signed TLS by default)
PROXMOX_INSECURE_TLS=true

# ---- SMTP (Nodemailer) -------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@vpsrumah.com
SMTP_PASS=change-me
SMTP_FROM="VPSRUMAH <noreply@vpsrumah.com>"

# ---- Payment (QRIS) ---------------------------------------------------
# Static QRIS image served at /static/payment/qris.jpg
PAYMENT_NOTE="Transfer sesuai nominal, lalu upload bukti. Maksimal verifikasi 24 jam."

# ---- Bootstrap admin ---------------------------------------------------
ADMIN_EMAIL=admin@vpsrumah.com
ADMIN_PASSWORD="Admin#1234"
ADMIN_NAME=Administrator

# ---- DEMO MODE ---------------------------------------------------------
# PROXMOX_MOCK=true : simulate Proxmox API + shell commands (iptables/nginx/certbot)
# and route outbound email to local file outputs/mock/inbox.json.
# Intented ONLY for local/CI testing — NEVER enable in the production host.
PROXMOX_MOCK=false
